// 1. Pipeline Parameters (accessible in main.nf via params.<name>)
params {
    reads          = "data/*_{1,2}.fastq.gz"
    genome         = "reference/genome.fa"
    outdir         = "results"
    max_cpus       = 16
    max_memory     = "64.GB"
    max_time       = "24.h"
}

// 2. Default Process Directives & Resource Management
process {
    // Default resources for all processes
    cpus           = 2
    memory         = "4.GB"
    time           = "2.h"

    // Error handling with dynamic resource scaling on retry
    errorStrategy  = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries     = 2

    // Target specific processes by label (e.g., label 'high_mem' in main.nf)
    withLabel: high_mem {
        cpus       = { check_max( 8 * task.attempt, 'cpus' ) }
        memory     = { check_max( 32.GB * task.attempt, 'memory' ) }
        time       = { check_max( 8.h * task.attempt, 'time' ) }
    }

    // Target a specific process by its exact name
    withName: 'FASTQC' {
        cpus       = 2
        memory     = "2.GB"
        publishDir = [
            path: "${params.outdir}/fastqc",
            mode: 'copy'
        ]
    }
}

// 3. Execution Profiles (activated via `-profile <name>`)
profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        conda.enabled          = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }

    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }

    slurm {
        process.executor       = 'slurm'
        process.queue          = 'normal'
        executor.queueSize     = 50
        executor.submitRateLimit = '10 sec'
    }
}

// 4. Execution Reports & Trace Logs
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}

// 5. Helper Function to Cap Dynamic Resources
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            return obj
        }
    }
}
